{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm ci --ignore-scripts",
  "functions": {
    "api/index.mjs": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index?route=health" },
    { "source": "/api/health", "destination": "/api/index?route=health" },
    { "source": "/api/status", "destination": "/api/index?route=status" },
    { "source": "/api/preflight", "destination": "/api/index?route=preflight" },
    { "source": "/api/plan", "destination": "/api/index?route=plan" },
    { "source": "/api/bills", "destination": "/api/index?route=bills" },
    { "source": "/api/roth", "destination": "/api/index?route=roth" },
    { "source": "/api/monthly", "destination": "/api/index?route=monthly" },
    { "source": "/api/alerts", "destination": "/api/index?route=alerts" },
    { "source": "/api/reconcile", "destination": "/api/index?route=reconcile" },
    { "source": "/api/webhook", "destination": "/api/index?route=webhook" }
  ],
  "crons": [{ "path": "/api/reconcile", "schedule": "0 15 * * *" }]
}
