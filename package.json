    "simulate:sequence": "node scripts/simulate-sequence.mjs",
    "build": "node scripts/build.mjs",
    "preflight": "node scripts/preflight.mjs"
  },
  "dependencies": {
    "@vercel/blob": "2.8.2",
    "@vercel/functions": "3.3.4",
    "@vercel/global-config": "1.5.1"
  },
  "overrides": {
    "@vercel/blob": {
      "@vercel/oidc": "3.5.0"
    }
  }
}
