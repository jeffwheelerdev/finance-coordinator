{
  "name": "finance-coordinator",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "description": "Monthly priority funding, income-source accounting and annual shortfall recovery for Sequence, staged for deliberate activation.",
  "engines": {
    "node": "22.x || 24.x"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
