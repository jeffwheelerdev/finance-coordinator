# Synthetic examples only. Keep real mappings, recipients and credentials private.
APP_MODE=observe
LIVE_TRANSFERS_ENABLED=false
MONTHLY_PRIORITY_ENABLED=true
FINANCE_CANONICAL_HOST=your-project.vercel.app

# Arbitrary dollar budget; target = monthly budget * reserve months.
GENERAL_SPENDING_MONTHLY_BUDGET=750
GENERAL_SPENDING_RESERVE_MONTHS=3
# Bills target comes from private Global Config. BILLS_BUFFER_TARGET is obsolete.
INCOME_RESERVE=0
MAX_BALANCE_AGE_HOURS=26

# Archived default. In monthly retirement mode, the reviewed manifest can retain
# the old Pod/rule IDs as audit references when omitted from these live mappings.
# It never creates a Pod dependency or claims that provider deletion happened.
FINANCE_ACCOUNT_IDS_JSON={"income":"11111111-1111-4111-8111-111111111111","pod":"22222222-2222-4222-8222-222222222222","general":"33333333-3333-4333-8333-333333333333","bills":"44444444-4444-4444-8444-444444444444"}
FINANCE_RULE_IDS_JSON={"payout":"55555555-5555-4555-8555-555555555555","funding":"66666666-6666-4666-8666-666666666666","legacyGeneral":"77777777-7777-4777-8777-777777777777"}
# The current monthly plan rejects extra legacy allocations.
FINANCE_ALLOCATIONS_JSON=[]

EMERGENCY_ACCOUNT_ID=88888888-8888-4888-8888-888888888888
PROJECT_ACCOUNT_ID=99999999-9999-4999-8999-999999999999
PERSONAL_INVESTMENT_ACCOUNT_ID=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa
EMERGENCY_EXCESS_RULE_ID=cccccccc-cccc-4ccc-8ccc-cccccccccccc
EMERGENCY_FUND_TARGET=10000

# Optional explicit retirement authorization; not enabled by this example.
# Complete shape and safe cleanup order: docs/sequence-integration.md.
# MONTHLY_SEQUENCE_RETIREMENT_JSON={"schemaVersion":1,"authorizedAt":"2030-01-01T00:00:00.000Z","reference":"Reviewed retirement authorization","podAccountId":"22222222-2222-4222-8222-222222222222","rules":{"payout":"55555555-5555-4555-8555-555555555555","funding":"66666666-6666-4666-8666-666666666666","legacyGeneral":"77777777-7777-4777-8777-777777777777","excess":"cccccccc-cccc-4ccc-8ccc-cccccccccccc"}}

# Configured destination does not prove eligibility or enable money movement.
ROTH_ENABLED=true
ROTH_ACCOUNT_ID=bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb
# Required in live mode. Choose a deliberate future UTC cutoff and retain it.
AUTOMATION_START_AT=

# Supply through private production settings; never commit actual values.
SEQUENCE_API_KEY=
BLOB_READ_WRITE_TOKEN=
# Read connection for bills_catalog, bills_monitor, roth_policy, monthly_policy,
# and activation_policy (including reviewed all-rules visibility after retirement).
GLOBAL_CONFIG=
CRON_SECRET=
# Optional actual signing secret for a registered Sequence webhook.
SEQUENCE_WEBHOOK_SECRET=

# Direct alert delivery is required before monthly financial activation.
# Provider setup and an authorized delivery check remain separate from tests.
RESEND_API_KEY=
ALERTS_EMAIL_TO=
ALERTS_EMAIL_FROM=
# onboarding@resend.dev is limited to the email on that Resend account.
# Use a verified sender domain when the provider requires it.

# Private dashboard. Enable only after verifying All Deployments protection
# and reviewing the project access audience; keep all money gates separate.
DASHBOARD_ENABLED=false
DASHBOARD_ACCESS_POLICY=
# Required assertion after verification: vercel-all-deployments

# Optional, narrowly authorized observe-only email setup test.
ALERTS_SETUP_TEST_ENABLED=false
ALERTS_SETUP_TEST_ID=
ALERTS_SETUP_TEST_AUTHORIZED_AT=
