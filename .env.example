# Synthetic examples only. Real mappings and credentials belong in private settings.
APP_MODE=observe
LIVE_TRANSFERS_ENABLED=false
# Required for production reconcile/webhook routes; use the stable production alias.
FINANCE_CANONICAL_HOST=your-project.vercel.app
GENERAL_SPENDING_MONTHLY_BUDGET=1000
GENERAL_SPENDING_RESERVE_MONTHS=3
BILLS_BUFFER_TARGET=2000
INCOME_RESERVE=0
MAX_BALANCE_AGE_HOURS=26
FINANCE_ACCOUNT_IDS_JSON={"income":"11111111-1111-4111-8111-111111111111","pod":"22222222-2222-4222-8222-222222222222","general":"33333333-3333-4333-8333-333333333333","bills":"44444444-4444-4444-8444-444444444444"}
FINANCE_RULE_IDS_JSON={"payout":"55555555-5555-4555-8555-555555555555","funding":"66666666-6666-4666-8666-666666666666","legacyGeneral":"77777777-7777-4777-8777-777777777777"}
FINANCE_ALLOCATIONS_JSON=[]
# Set a deliberate UTC start when activating. Never roll it forward to clear errors.
AUTOMATION_START_AT=
# Supply these through Vercel, never commit actual values.
SEQUENCE_API_KEY=
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
# Optional: use the actual signing secret generated by the registered Sequence endpoint.
SEQUENCE_WEBHOOK_SECRET=
